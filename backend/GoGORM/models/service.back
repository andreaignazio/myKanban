package models

import "errors"

type MembershipRepo interface {
	LinkUserToBoardWithRole(boardID, userID uint, role string) error
	GetUserRole(userID, boardID uint) (string, error)
}


type MembershipService struct {
	repo MembershipRepo
}

func NewMembershipService(repo MembershipRepo) *MembershipService {
	return &MembershipService{repo: repo}
}

type BoardRepo interface {
	
	CreateListAndLinkToBoard(list *List, boardID uint) error
}

type BoardService struct {
	members MembershipRepo
	repo BoardRepo
}

func NewBoardService(repo BoardRepo, members MembershipRepo) *BoardService {
	return &BoardService{repo:	repo, members: members}
}

type CardRepo interface {
	HasMinimumRoleInBoardOfList(userID, listID uint, minroles []string) (bool,error)
	LinkCardToList(cardID, listID uint) error
}

type CardService struct {
	repo CardRepo

}

func NewCardService(repo CardRepo) *CardService {
	return &CardService{repo:repo}
}



var validRoles = map[string]int{
	"owner": 3,
	"admin": 2,
	"member": 1,
	"viewer": 0,
}

func isValidRole(role string) bool {
	if _, ok := validRoles[role]; !ok{
		return false
	}
	return true
}

func hasHigherRole(role, minRole string) bool {
	roleLevel, ok1 := validRoles[role]
	minLevel, ok2 := validRoles[minRole]

	if !ok1 || !ok2 {
		return false
	}
	return roleLevel >= minLevel

}



func (s *MembershipService) AddMemberToBoard(requesterID, newMemberID, boardID uint, role string) error {

	requesterRole, err := s.repo.GetUserRole(requesterID, boardID)
	if err != nil {
		return err
	}
	if requesterRole != "owner" && requesterRole != "admin" {
		return errors.New("Requester is not authorized to add member to board")
	}

	if !isValidRole(role){
		return errors.New("Role is not valid")
	}

	if err := s.repo.LinkUserToBoardWithRole(boardID, newMemberID, role); err != nil {
		return err

	}
	return nil
}


func (s *BoardService) CreateListIntoBoard(listTitle string, requesterID, boardID uint) (*List, error) {

	if listTitle == ""{
		return nil, errors.New("Title is not valid")
	}

	requesterRole, err := s.members.GetUserRole(requesterID, boardID)
	if err != nil{
		return nil, err
	}

	if !hasHigherRole(requesterRole, "member") {
		return nil, errors.New("Requester is not auhorized")
	}

	newList := &List{Title: listTitle}

	err = s.repo.CreateListAndLinkToBoard(newList, boardID)
	if err!= nil {
		return nil, err

	}
	return newList, nil
}

func (s *CardService) AttachCardToList(requesterID, cardID, listID uint) error {

	minroles := []string{"member", "owner", "admin"}
	ok, err :=s.repo.HasMinimumRoleInBoardOfList(requesterID, listID, minroles)
	if err != nil {return err}
	if !ok {
		return errors.New("User is not authorized")
	}

	if err = s.repo.LinkCardToList(cardID, listID); err != nil {
		return err
	}

	return nil
	
}